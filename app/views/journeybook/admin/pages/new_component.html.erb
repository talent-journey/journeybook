<% content_for :main_class, "jb-main-wide" %>

<div class="jb-component-add-page">
  <aside class="jb-card jb-component-picker" aria-label="Available components">
    <p class="jb-eyebrow">Add component</p>
    <h1 class="jb-card-title"><%= @page.title %></h1>

    <% if @components.any? %>
      <div data-controller="journeybook-component-search">
        <label class="jb-component-search">
          Search components
          <input type="search" placeholder="Search" autocomplete="off" autofocus data-journeybook-component-search-target="input" data-action="input->journeybook-component-search#filter">
        </label>
        <nav class="jb-component-nav">
          <% @components.each do |component| %>
            <div class="jb-component-nav-item" data-journeybook-component-search-target="item" data-component-search-name="<%= component.name %>">
              <%= link_to new_component_admin_page_path(@page, site_id: @page.site_id, component: component.name), class: ("is-active" if component == @selected_component), "aria-current": ("page" if component == @selected_component) do %>
                <strong><%= component.name %></strong>
                <% if component.metadata[:description].present? %>
                  <span><%= component.metadata[:description] %></span>
                <% end %>
              <% end %>
              <%= button_to "+", add_component_admin_page_path(@page, site_id: @page.site_id), method: :post, params: { component_name: component.name }, class: "jb-component-add-button", title: "Add #{component.name}", aria: { label: "Add #{component.name}" } %>
            </div>
          <% end %>
        </nav>
      </div>
    <% else %>
      <p class="jb-subtitle">No components are registered for this site.</p>
    <% end %>

    <div class="jb-component-add-sidebar-footer">
      <%= link_to "Back to editor", edit_admin_page_path(@page, site_id: @page.site_id, tab: "layout"), class: "jb-button jb-button-secondary" %>
    </div>
  </aside>

  <main class="jb-card jb-component-add-preview">
    <% if @selected_component %>
      <header class="jb-header">
        <div>
          <p class="jb-eyebrow">Preview</p>
          <h2 class="jb-title"><code>{{ <%= @selected_component.name %> }}</code></h2>
          <% if @selected_component.metadata[:description].present? %>
            <p class="jb-subtitle"><%= @selected_component.metadata[:description] %></p>
          <% end %>
        </div>
      </header>

      <iframe class="jb-preview jb-component-add-preview-frame" src="<%= admin_component_preview_path(@selected_component.name, site_id: @page.site_id) %>" title="<%= @selected_component.name %> preview"></iframe>

    <% else %>
      <p class="jb-subtitle">Select a component to preview it.</p>
    <% end %>
  </main>
</div>

<%= javascript_tag nonce: true do %>
  (() => {
    const search = document.querySelector("[data-component-search]");
    const items = document.querySelectorAll("[data-component-search-item]");
    if (!search || !items.length) return;

    search.addEventListener("input", () => {
      const query = search.value.trim().toLowerCase();
      items.forEach((item) => {
        item.hidden = Boolean(query) && !item.dataset.componentSearchItem.toLowerCase().includes(query);
      });
    });
  })();
<% end %>
